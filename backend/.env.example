# Server Configuration
DEBUG=True
APP_NAME=SmartStudent API
APP_VERSION=1.0.0

# Database Configuration
# For PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/smartstudent

# For SQLite (development)
# DATABASE_URL=sqlite:///./smartstudent.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secrets (generate strong secrets in production)
SECRET_KEY=your-super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Configuration (optionnel — Groq est utilisé en priorité)
OPENAI_API_KEY=sk-proj-VOTRE_CLE_OPENAI_ICI
OPENAI_MODEL=gpt-4o-mini

# Groq Configuration (LLM gratuit — prioritaire)
GROQ_API_KEY=gsk_VOTRE_CLE_GROQ_ICI

# Pinecone Configuration (optionnel)
PINECONE_API_KEY=pcsk_VOTRE_CLE_PINECONE_ICI
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=smartstudent

# Firebase Configuration (for push notifications)
FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json

# CORS Origins
ALLOWED_ORIGINS=["http://localhost", "http://localhost:8000", "http://localhost:3000"]
